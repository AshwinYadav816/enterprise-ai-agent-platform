# Copy to .env and fill in. Never commit .env.

# Mistral (only LLM / embedding provider)
MISTRAL_API_KEY=your-mistral-api-key
FAST_MODEL=ministral-8b-latest
SMART_MODEL=ministral-14b-latest
EMBEDDING_MODEL=mistral-embed
FAST_REASONING_EFFORT=none
EMBED_BATCH_SIZE=16
MAX_UPLOAD_MB=25
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=1.0

# Qdrant (docker compose up -d)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Cache: leave REDIS_URL empty for an in-process cache (e.g. redis://localhost:6379/0)
REDIS_URL=
CACHE_MAX_ITEMS=5000
QUERY_EMBEDDING_TTL=3600

# Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Retrieval
TOP_K=20
FINAL_K=5
SCORE_THRESHOLD=0.62
MMR_LAMBDA=0.7
MAX_CONTEXT_TOKENS=6000

# Agents (map-reduce for long transcripts/documents)
LONG_INPUT_TOKENS=6000
MAP_CHUNK_TOKENS=3000
