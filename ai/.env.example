# Copy to .env and fill in. Never commit .env.

# Mistral (only LLM / embedding provider)
MISTRAL_API_KEY=your-mistral-api-key
FAST_MODEL=ministral-8b-latest
SMART_MODEL=ministral-14b-latest
EMBEDDING_MODEL=mistral-embed
FAST_REASONING_EFFORT=none
EMBED_BATCH_SIZE=16
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Qdrant (docker compose up -d)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Retrieval
TOP_K=20
FINAL_K=5
SCORE_THRESHOLD=0.62
MMR_LAMBDA=0.7
MAX_CONTEXT_TOKENS=6000

# Agents (map-reduce for long transcripts/documents)
LONG_INPUT_TOKENS=6000
MAP_CHUNK_TOKENS=3000
