# Copy to .env (in Backend/) and fill in. Never commit .env.

# --- Backend ------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://eap:eap@127.0.0.1:5432/eap
TEST_DATABASE_URL=postgresql+asyncpg://eap:eap@127.0.0.1:5432/eap_test
REDIS_URL=redis://127.0.0.1:6379/0

# Generate one: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Next.js dev server. No comments after values: Docker --env-file and hosting dashboards keep them.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

STORAGE_BACKEND=local
STORAGE_DIR=data/uploads
S3_BUCKET=
S3_REGION=
# S3-compatible service (Supabase Storage, R2, B2); empty = AWS. Keys: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
S3_ENDPOINT_URL=
MAX_UPLOAD_MB=25
MAX_JSON_BODY_KB=1024

# fake = no Mistral calls (UI work, tests) · real = use the AI module below
AI_MODE=fake
LOGIN_PER_MIN=5
AI_PER_MIN=30
AI_ORG_PER_MIN=60
SSE_HEARTBEAT_SECONDS=15
# fake mode only: ms between fake AI events, so the UI shows streaming (0 = instant)
FAKE_AI_DELAY_MS=80

# --- AI module (eap_ai reads these from this same file) ----------------------------
# Full list and defaults: ../ai/README.md "Configuration"
MISTRAL_API_KEY=your-mistral-api-key
FAST_MODEL=ministral-8b-latest
SMART_MODEL=ministral-14b-latest
# Per-task model override (JSON; tasks in ai/README.md "Models per task"), e.g. {"email": "ministral-8b-latest"}
TASK_MODELS={}
# Used in order when a model is busy / rate-limited / down
FAST_FALLBACK_MODELS=["ministral-3b-latest"]
SMART_FALLBACK_MODELS=["ministral-8b-latest"]
EMBEDDING_MODEL=mistral-embed
QDRANT_URL=http://127.0.0.1:6333
# eap_ai also reads REDIS_URL above for its embedding cache (keys prefixed eap:emb:, no clashes
# with the backend's rate-limit keys).
