    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
